# Copy to `.env` in the repo root; docker compose reads it automatically.
# `.env` is git-ignored, so the real secret never gets committed.

# JWT signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty, the backend container generates a random secret at each start,
# so everyone is logged out whenever the backend restarts.
SECRET_KEY=

# --- Normal mode (default) ---------------------------------------------------
# Public registration creates students only. Create the first admin with:
#   docker compose exec backend python -m app.cli create-admin --email admin@example.com
ENVIRONMENT=development
PUBLIC_TEST_MODE=false

# --- Public test-suite mode ----------------------------------------------------
# The tests in tests/public register instructor/admin accounts directly, which
# the backend only allows in this mode. Use it when running the test suite.
# ENVIRONMENT=test
# PUBLIC_TEST_MODE=true

# --- Face enrollment approval ----------------------------------------------------
# A student's face enrollment stays pending until an instructor/TA of one of their
# courses (or an admin) approves it in the dashboard, after checking in person that
# the right student enrolled.
#   auto  (default) on, except when PUBLIC_TEST_MODE=true, where the graders' tests
#         expect the API specification's immediate POST /users/me/face/enroll
#   true  always on, even in public test mode
#   false always off
FACE_ENROLLMENT_APPROVAL=auto
